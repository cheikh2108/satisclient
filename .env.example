# PostgreSQL
POSTGRES_PASSWORD=change_this_strong_password

# JWT
JWT_SECRET=generate_with_openssl_rand_hex_64
JWT_REFRESH_SECRET=generate_with_openssl_rand_hex_64

# Encryption
ENCRYPTION_KEY=generate_with_openssl_rand_hex_32

# URLs (remplacer par vos vrais domaines)
BACKEND_URL=https://api.satisclient.sn
FRONTEND_URL=https://app.satisclient.sn

# Email Resend (utiliser un domaine vérifié dans Resend)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=SatisClient <noreply@votre-domaine.tld>
