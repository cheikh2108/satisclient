# ==============================================
# SATISCLIENT - Variables d'environnement V1
# ==============================================
# Copier ce fichier en backend/.env et configurer les valeurs

# Environment
NODE_ENV=development

# ==============================================
# DATABASE
# ==============================================
# PostgreSQL natif Windows (créer la base avec : CREATE DATABASE satisclient_dev OWNER satisclient;)
DATABASE_URL=postgresql://satisclient:satisclient_password@localhost:5432/satisclient_dev?schema=public

# ==============================================
# JWT / AUTH
# ==============================================
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# ENCRYPTION
# ==============================================
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-generate-this

# ==============================================
# BACKEND API
# ==============================================
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ==============================================
# FRONTEND
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# FILE STORAGE (Local uniquement pour v1)
# ==============================================
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# ==============================================
# QR CODE
# ==============================================
QR_CODE_BASE_URL=http://localhost:3000/feedback

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug

# ==============================================
# V2 - À CONFIGURER PLUS TARD
# ==============================================
# REDIS (Cache & Queues)
# EMAIL (Nodemailer SMTP)
# SMS (Twilio / Africa's Talking)
# WHATSAPP (Twilio)
# AI (OpenAI pour sentiment analysis)
# CLOUD STORAGE (AWS S3 / MinIO)
# PAYMENT (Stripe / PayDunia)
# MONITORING (Sentry)
