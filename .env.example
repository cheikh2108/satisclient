# ==============================================
# SATISCLIENT - Variables d'environnement
# ==============================================

# Environment
NODE_ENV=development

# ==============================================
# DATABASE
# ==============================================
DATABASE_URL="postgresql://satisclient:satisclient_password@localhost:5432/satisclient_dev?schema=public"

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# JWT / AUTH
# ==============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# ENCRYPTION (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# ==============================================
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here-generate-with-crypto

# ==============================================
# BACKEND API
# ==============================================
BACKEND_PORT=3001
BACKEND_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# ==============================================
# FRONTEND
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# EMAIL (Nodemailer)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM="SatisClient <noreply@satisclient.sn>"

# ==============================================
# SMS (Twilio ou Africa's Talking)
# ==============================================
# Twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+221XXXXXXXXX

# Africa's Talking (Alternative)
# AT_USERNAME=your-at-username
# AT_API_KEY=your-at-api-key
# AT_FROM=SATISCLIENT

# ==============================================
# WHATSAPP (Twilio)
# ==============================================
TWILIO_WHATSAPP_NUMBER=whatsapp:+221XXXXXXXXX

# ==============================================
# FILE STORAGE
# ==============================================
STORAGE_TYPE=local # local, s3, minio
STORAGE_PATH=./uploads

# AWS S3 (si STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=satisclient-uploads

# MinIO (si STORAGE_TYPE=minio)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=satisclient

# ==============================================
# AI / SENTIMENT ANALYSIS
# ==============================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==============================================
# QR CODE
# ==============================================
QR_CODE_BASE_URL=http://localhost:3000/feedback

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==============================================
# MONITORING / LOGGING
# ==============================================
SENTRY_DSN=
LOG_LEVEL=debug # debug, info, warn, error

# ==============================================
# PAYMENT (Future)
# ==============================================
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# PAYDUNIA_API_KEY=
